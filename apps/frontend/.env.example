# Base URL of the API Gateway stage the frontend talks to.
# Read at BUILD time (Next.js static export) -- rebuilding is required to change it.
# Without it, apps/frontend/src/lib/api.ts falls back to per-service localhost ports.
#   production: https://<api-id>.execute-api.us-east-2.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# Set only by the preview-env workflow, which serves each PR under /pr-<N>/.
# Leave empty for local development and for the production build.
PREVIEW_BASE_PATH=
