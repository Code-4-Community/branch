{
  "name": "lambda-local",
  "version": "1.0.0",
  "private": true,
  "main": "handler.ts",
  "scripts": {
    "dev": "ts-node --transpile-only dev-server.ts",
    "build": "tsc",
    "test": "start-server-and-test dev http-get://localhost:3000/projects/health jest",
    "package": "esbuild handler.ts --bundle --platform=node --target=node20 --minify '--external:@aws-sdk/*' --outfile=dist/handler.js && cd dist && zip -q ../lambda.zip handler.js"
  },
  "devDependencies": {
    "@branch/types": "file:../../../../shared/types",
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.25.12",
    "jest": "^30.4.2",
    "js-yaml": "^4.1.0",
    "start-server-and-test": "^2.1.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@branch/lambda-auth": "file:../../../../shared/lambda-auth",
    "@branch/lambda-http": "file:../../../../shared/lambda-http",
    "@branch/rbac": "file:../../../../shared/rbac",
    "aws-jwt-verify": "^5.1.1",
    "kysely": "^0.28.8",
    "pg": "^8.16.3"
  }
}
