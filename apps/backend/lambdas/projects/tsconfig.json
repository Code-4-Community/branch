{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "sourceMap": true,
    "types": ["jest"]
  },
  "include": ["*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "dev-server.ts", "swagger-utils.ts"]
}
