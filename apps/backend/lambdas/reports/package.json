{
  "name": "lambda-local",
  "version": "1.0.0",
  "private": true,
  "main": "handler.ts",
  "scripts": {
    "dev": "ts-node --transpile-only dev-server.ts",
    "build": "tsc",
    "test": "jest --forceExit",
    "test:e2e": "start-server-and-test dev http-get://localhost:3000/reports/health 'jest --testMatch=\"**/*.e2e.test.ts\" --forceExit'",
    "package": "npm run build && cd dist && zip -r ../lambda.zip . -x '*.map' 'dev-server.*' 'swagger-utils.*'"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.6",
    "js-yaml": "^4.1.0",
    "start-server-and-test": "^2.1.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.1.1",
    "aws-lambda": "^1.0.7",
    "jest": "^30.2.0",
    "kysely": "^0.28.8",
    "pg": "^8.16.3"
  }
}
